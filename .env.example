# Confluence API CLI - Environment Variables
# .env.example -> .env 로 복사 후 값을 채워주세요.

# 사이트 주소
# Cloud 예시:
#   CONFLUENCE_DOMAIN=yourcompany.atlassian.net
#   CONFLUENCE_CONTEXT_PATH=/wiki
# Server/DC 예시:
#   CONFLUENCE_BASE_URL=https://confluence.example.com/confluence
CONFLUENCE_DOMAIN=yourcompany.atlassian.net
CONFLUENCE_CONTEXT_PATH=/wiki
# CONFLUENCE_BASE_URL=https://confluence.example.com/confluence

# 인증 방식 — 어떤 값을 쓸지 헷갈리면 아래 기준으로 고르세요.
#   basic  = 이메일/유저명 + API 토큰(PAT)을 "Authorization: Basic <base64>"로 전송.
#            · Cloud: CONFLUENCE_EMAIL + CONFLUENCE_API_TOKEN (id.atlassian.com에서 발급한 API 토큰)
#            · Server/DC: CONFLUENCE_USERNAME + CONFLUENCE_SECRET (계정 비밀번호 또는 PAT)
#   bearer = CONFLUENCE_SECRET 하나만 "Authorization: Bearer <token>"으로 전송. 이메일/유저명 불필요.
#            · Cloud: OAuth 2.0 access token을 발급받아 사용하는 경우
#            · Server/DC: Personal Access Token(PAT)을 Bearer 헤더로 요구하는 인스턴스인 경우
# 대부분의 Cloud 개인 API 토큰 사용자는 basic이면 충분합니다.
CONFLUENCE_AUTH_TYPE=basic

# Cloud basic auth
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your_cloud_api_token

# Server/DC basic auth or PAT
# CONFLUENCE_USERNAME=your_username
# CONFLUENCE_SECRET=your_password_or_pat

# Cloud bearer auth / OAuth access token
# CONFLUENCE_AUTH_TYPE=bearer
# CONFLUENCE_SECRET=your_oauth_access_token

# 아래 두 값은 선택 사항입니다. 지정하지 않으면 도메인을 보고 자동으로 판별합니다:
#   CONFLUENCE_DOMAIN(또는 CONFLUENCE_BASE_URL)이 *.atlassian.net → platform=cloud, api_version=v2
#   그 외 도메인                                  → platform=server, api_version=v1
# 자동 판별이 맞지 않는 경우(예: Cloud 커스텀 도메인)에만 명시적으로 지정하세요.
# CONFLUENCE_PLATFORM=cloud
# CONFLUENCE_API_VERSION=v2

# 버전별 인증 타입을 따로 지정하고 싶을 때만 사용하세요.
# 기본값은 CONFLUENCE_AUTH_TYPE 값을 따라갑니다.
# CONFLUENCE_V1_AUTH_TYPE=basic
# CONFLUENCE_V2_AUTH_TYPE=bearer

# 로그 레벨 (debug, info, warn, error) - 기본: info
# LOG_LEVEL=info
