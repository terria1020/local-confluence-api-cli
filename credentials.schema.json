{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Credentials",
  "description": "Confluence site credentials configuration for local-confluence-api-cli",
  "type": "object",
  "required": ["version", "sites"],
  "properties": {
    "version": { "type": "string", "enum": ["1.0"] },
    "description": { "type": "string" },
    "sites": {
      "type": "array",
      "items": { "$ref": "#/definitions/site" }
    }
  },
  "definitions": {
    "site": {
      "type": "object",
      "required": ["id", "authType"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "domain": { "type": "string", "description": "Hostname without protocol" },
        "baseUrl": { "type": "string", "format": "uri" },
        "contextPath": { "type": "string" },
        "platform": { "type": "string", "enum": ["cloud", "server"] },
        "apiVersion": { "type": "string", "enum": ["v1", "v2"] },
        "authType": { "type": "string", "enum": ["basic", "bearer"] },
        "v1AuthType": { "type": "string", "enum": ["basic", "bearer"] },
        "v2AuthType": { "type": "string", "enum": ["basic", "bearer"] },
        "email": { "type": "string", "format": "email" },
        "username": { "type": "string" },
        "apiToken": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$", "description": "Base64 encoded API token" },
        "secret": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$", "description": "Base64 encoded password, PAT, or bearer token" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "anyOf": [
            { "required": ["domain"] },
            { "required": ["baseUrl"] }
          ]
        },
        {
          "anyOf": [
            { "required": ["apiToken"] },
            { "required": ["secret"] }
          ]
        },
        {
          "if": { "properties": { "authType": { "const": "basic" } } },
          "then": {
            "anyOf": [
              { "required": ["email"] },
              { "required": ["username"] }
            ]
          }
        }
      ]
    }
  }
}
